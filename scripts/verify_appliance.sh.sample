#!/bin/bash
# ==============================================================================
# OSYS3030 - Network Appliance Automated Verification Suite (Sample)
# Validates systemd services, configuration syntax, listening ports, and NAT
# ==============================================================================

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'
FAIL_COUNT=0

check() {
  local description="$1"
  shift
  if eval "$@" >/dev/null 2>&1; then
    printf "  %-60s [ ${GREEN}PASS${NC} ]\n" "$description"
  else
    printf "  %-60s [ ${RED}FAIL${NC} ]\n" "$description"
    FAIL_COUNT=$((FAIL_COUNT + 1))
  fi
}

echo "=========================================================="
echo "  OSYS3030 Appliance Health & Verification Suite"
echo "=========================================================="

echo "--- 1. BIND9 DNS Service ---"
check "BIND9 service is active" "systemctl is-active --quiet named"
check "BIND9 configuration syntax (named-checkconf)" "named-checkconf"
check "DNS listening on UDP port 53" "ss -uln | grep -q ':53 '"
check "Local DNS resolution for innovate.lab" "dig @127.0.0.1 ns1.innovate.lab +short | grep -q '10.'"

echo "--- 2. Kea DHCPv4 Service ---"
check "Kea DHCPv4 service is active" "systemctl is-active --quiet kea-dhcp4-server"
check "Kea configuration syntax (kea-dhcp4 -t)" "kea-dhcp4 -t /etc/kea/kea-dhcp4.conf"
check "DHCP listening on UDP port 67" "ss -uln | grep -q ':67 '"

echo "--- 3. Host Hardening & SSH ---"
check "OpenSSH service is active" "systemctl is-active --quiet ssh"
check "SSH listening on TCP port 22" "ss -tln | grep -q ':22 '"

echo "--- 4. Firewall & Routing ---"
check "UFW firewall is active" "ufw status | grep -q 'Status: active'"
check "IPv4 packet forwarding enabled" "sysctl net.ipv4.ip_forward | grep -q '1'"
check "iptables NAT MASQUERADE rule present" "iptables -t nat -L POSTROUTING -v -n | grep -q 'MASQUERADE'"

echo "=========================================================="
if [ "$FAIL_COUNT" -eq 0 ]; then
  echo -e "  ${GREEN}All appliance health checks passed successfully!${NC}"
  exit 0
else
  echo -e "  ${RED}$FAIL_COUNT check(s) failed. Review configuration guides.${NC}"
  exit 1
fi
